# ============================================================
# KAVYA PORTFOLIO — ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git!
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose publicly, use only server-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Site Config ────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://kavya.dev

# ─── Email (Resend) ─────────────────────────────────────────
# Get a FREE API key at: https://resend.com → Signup → API Keys → Create Key
# Free tier: 100 emails/day, no credit card needed
# IMPORTANT: Also verify your domain in Resend dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Analytics (optional but recommended) ─────────────────────
# Google Analytics 4
# 1. Go to https://analytics.google.com → Create Property
# 2. Get Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Microsoft Clarity
# 1. Go to https://clarity.microsoft.com → New Project
# 2. Get Project ID (10-char string)
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx
